# Compares two recordings of the golden corpus file by file (issue #55; the target golden_reproducible of
# cmake/OracleX86.cmake records the corpus twice from the same build and runs this on the two folders).
# Arguments: -DA=<folder> -DB=<folder>: prints one line per file ("same", "differs", "only in A/B") and a
# summary, and fails when any file differs or is missing on one side or when neither folder has a file;
# with -DREMOVE=ON the two folders are removed when they are the same (the script's own folders: they
# hold no links). -DSELFTEST=<folder>: the comparison on small folders it writes below <folder> (the
# same files; a changed byte; a missing file; empty), then removes them.

function(compare_recordings a b result)
	file(GLOB_RECURSE files_a RELATIVE "${a}" "${a}/*")
	file(GLOB_RECURSE files_b RELATIVE "${b}" "${b}/*")
	set(files ${files_a} ${files_b})
	list(REMOVE_DUPLICATES files)
	list(SORT files)
	set(compared 0)
	set(different 0)
	foreach(file IN LISTS files)
		math(EXPR compared "${compared} + 1")
		if(NOT EXISTS "${a}/${file}")
			message(STATUS "only in B: ${file}")
			math(EXPR different "${different} + 1")
		elseif(NOT EXISTS "${b}/${file}")
			message(STATUS "only in A: ${file}")
			math(EXPR different "${different} + 1")
		else()
			execute_process(COMMAND "${CMAKE_COMMAND}" -E compare_files "${a}/${file}" "${b}/${file}"
				RESULT_VARIABLE same)
			if(same EQUAL 0)
				message(STATUS "same: ${file}")
			else()
				message(STATUS "differs: ${file}")
				math(EXPR different "${different} + 1")
			endif()
		endif()
	endforeach()
	message(STATUS "${compared} files compared, ${different} different")
	if(compared EQUAL 0 OR NOT different EQUAL 0)
		set(${result} FALSE PARENT_SCOPE)
	else()
		set(${result} TRUE PARENT_SCOPE)
	endif()
endfunction()

if(DEFINED SELFTEST)
	set(root "${SELFTEST}/golden-compare-selftest")
	file(REMOVE_RECURSE "${root}")
	file(WRITE "${root}/a/difftest/Test.bin" "PGLD 1")
	file(WRITE "${root}/a/difftest/manifest.tsv" "format\t2\n")
	file(WRITE "${root}/b/difftest/Test.bin" "PGLD 1")
	file(WRITE "${root}/b/difftest/manifest.tsv" "format\t2\n")
	compare_recordings("${root}/a" "${root}/b" same)
	if(NOT same)
		message(FATAL_ERROR "CompareGoldenRecordings.cmake self-test: equal folders reported different")
	endif()
	file(WRITE "${root}/b/difftest/Test.bin" "PGLD 2")
	compare_recordings("${root}/a" "${root}/b" same)
	if(same)
		message(FATAL_ERROR "CompareGoldenRecordings.cmake self-test: a changed byte not found")
	endif()
	file(WRITE "${root}/b/difftest/Test.bin" "PGLD 1")
	file(REMOVE "${root}/b/difftest/manifest.tsv")
	compare_recordings("${root}/a" "${root}/b" same)
	if(same)
		message(FATAL_ERROR "CompareGoldenRecordings.cmake self-test: a missing file not found")
	endif()
	file(MAKE_DIRECTORY "${root}/c" "${root}/d")
	compare_recordings("${root}/c" "${root}/d" same)
	if(same)
		message(FATAL_ERROR "CompareGoldenRecordings.cmake self-test: two empty folders reported the same")
	endif()
	file(REMOVE_RECURSE "${root}")
	message(STATUS "CompareGoldenRecordings.cmake self-test passed")
	return()
endif()

foreach(argument A B)
	if(NOT DEFINED ${argument})
		message(FATAL_ERROR "CompareGoldenRecordings.cmake: -D${argument}=... is missing")
	endif()
endforeach()
compare_recordings("${A}" "${B}" same)
if(NOT same)
	message(FATAL_ERROR "The two recordings differ (kept: ${A}, ${B})")
endif()
message(STATUS "The two recordings are the same byte for byte")
if(REMOVE)
	file(REMOVE_RECURSE "${A}" "${B}")
endif()
