	0xF121                  "%1\nCannot find this file.\nPlease verify that the correct path and file name are given."  // AFX_IDP_FAILED_INVALID_PATH
	0xF122                  "Destination disk drive is full."            // AFX_IDP_FAILED_DISK_FULL
	0xF123                  "Unable to read from %1, it is opened by someone else."              // AFX_IDP_FAILED_ACCESS_READ
	0xF124                  "Unable to write to %1, it is read-only or opened by someone else."  // AFX_IDP_FAILED_ACCESS_WRITE
