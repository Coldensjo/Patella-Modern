	0xF111                  "Please enter a number."                     // AFX_IDP_PARSE_REAL
	0xF112                  "Please enter an integer between %1 and %2." // AFX_IDP_PARSE_INT_RANGE
	0xF113                  "Please enter a number between %1 and %2."   // AFX_IDP_PARSE_REAL_RANGE
	0xF114                  "Please enter no more than %1 characters."   // AFX_IDP_PARSE_STRING_SIZE
	0xF115                  "Please select a button."                    // AFX_IDP_PARSE_RADIO_BUTTON
	0xF116                  "Please enter an integer between 0 and 255." // AFX_IDP_PARSE_BYTE
	0xF117                  "Please enter a positive integer."           // AFX_IDP_PARSE_UINT
	0xF118                  "Please enter a date and/or time."           // AFX_IDP_PARSE_DATETIME
	0xF119                  "Please enter a currency."                   // AFX_IDP_PARSE_CURRENCY
	0xF11A                  "Please enter a GUID."                       // AFX_IDP_PARSE_GUID
	0xF11B                  "Please enter a time."                       // AFX_IDP_PARSE_TIME
	0xF11C                  "Please enter a date."                       // AFX_IDP_PARSE_DATE
END

STRINGTABLE
BEGIN
