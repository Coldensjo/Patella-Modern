	0xF105                  "The file is too large to open."             // AFX_IDP_FILE_TOO_LARGE
	0xF106                  "Could not start print job."                 // AFX_IDP_FAILED_TO_START_PRINT
	0xF107                  "Failed to launch help."                     // AFX_IDP_FAILED_TO_LAUNCH_HELP
	0xF108                  "Internal application error."                // AFX_IDP_INTERNAL_FAILURE
	0xF109                  "Command failed."                            // AFX_IDP_COMMAND_FAILURE
	0xF10A                  "Insufficient memory to perform operation."  // AFX_IDP_FAILED_MEMORY_ALLOC
	0xF10B                  "System registry entries have been removed and the INI file (if any) was deleted."  // AFX_IDP_UNREG_DONE
	0xF10C                  "Not all of the system registry entries (or INI file) were removed."                // AFX_IDP_UNREG_FAILURE
	0xF10D                  "This program requires the file %s, which was not found on this system."           // AFX_IDP_DLL_LOAD_FAILED
