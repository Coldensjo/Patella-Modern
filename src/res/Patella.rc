	0xF101                  "Failed to open document."                   // AFX_IDP_FAILED_TO_OPEN_DOC
	0xF102                  "Failed to save document."                   // AFX_IDP_FAILED_TO_SAVE_DOC
	0xF103                  "Save changes to %1?"                        // AFX_IDP_ASK_TO_SAVE
