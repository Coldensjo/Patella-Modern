	0xF130                  "%1: %2\nContinue running script?"           // AFX_IDP_SCRIPT_ERROR
	0xF131                  "Dispatch exception: %1"                     // AFX_IDP_SCRIPT_DISPATCH_EXCEPTION
END

STRINGTABLE
