	0xF191                  "Mail system DLL is invalid."                // AFX_IDP_INVALID_MAPI_DLL
	0xF192                  "Send Mail failed to send message."          // AFX_IDP_FAILED_MAPI_SEND
END

STRINGTABLE
BEGIN
	0xF1A0                  "No error occurred."                         // AFX_IDP_FILE_NONE
	0xF1A1                  "An unknown error occurred while accessing %1."                      // AFX_IDP_FILE_GENERIC
	0xF1A2                  "%1 was not found."                          // AFX_IDP_FILE_NOT_FOUND
	0xF1A3                  "%1 contains an invalid path."               // AFX_IDP_FILE_BAD_PATH
	0xF1A4                  "%1 could not be opened because there are too many open files."     // AFX_IDP_FILE_TOO_MANY_OPEN
	0xF1A5                  "Access to %1 was denied."                   // AFX_IDP_FILE_ACCESS_DENIED
	0xF1A6                  "An invalid file handle was associated with %1."                     // AFX_IDP_FILE_INVALID_FILE
	0xF1A7                  "%1 could not be removed because it is the current directory."      // AFX_IDP_FILE_REMOVE_CURRENT
	0xF1A8                  "%1 could not be created because the directory is full."            // AFX_IDP_FILE_DIR_FULL
	0xF1A9                  "Seek failed on %1"                          // AFX_IDP_FILE_BAD_SEEK
	0xF1AA                  "A hardware I/O error was reported while accessing %1."              // AFX_IDP_FILE_HARD_IO
	0xF1AB                  "A sharing violation occurred while accessing %1."                   // AFX_IDP_FILE_SHARING
	0xF1AC                  "A locking violation occurred while accessing %1."                   // AFX_IDP_FILE_LOCKING
	0xF1AD                  "Disk full while accessing %1."              // AFX_IDP_FILE_DISKFULL
	0xF1AE                  "An attempt was made to access %1 past its end."                     // AFX_IDP_FILE_EOF
END

STRINGTABLE
BEGIN
	0xF1B0                  "No error occurred."                         // AFX_IDP_ARCH_NONE
	0xF1B1                  "An unknown error occurred while accessing %1."                      // AFX_IDP_ARCH_GENERIC
	0xF1B2                  "An attempt was made to write to the reading %1."                    // AFX_IDP_ARCH_READONLY
	0xF1B3                  "An attempt was made to access %1 past its end."                     // AFX_IDP_ARCH_ENDOFFILE
	0xF1B4                  "An attempt was made to read from the writing %1."                   // AFX_IDP_ARCH_WRITEONLY
	0xF1B5                  "%1 has a bad format."                       // AFX_IDP_ARCH_BADINDEX
	0xF1B6                  "%1 contained an unexpected object."         // AFX_IDP_ARCH_BADCLASS
	0xF1B7                  "%1 contains an incorrect schema."           // AFX_IDP_ARCH_BADSCHEMA
