// Resource script of Patella, the reconstruction of the Tibia 7.72 client.
//
// Every entry has the type, ID and language of Tibia.exe's .rsrc section and compiles to
// the same bytes (tools/compare_resources.py; notes/resources.md lists the entries and
// their users). The pictures (cursors, icon, bitmaps) are not in the repository: run
//	python -I tools/extract_resources.py Tibia.exe build/res
// and compile with build/res on the include path (CMake does both, into build/<preset>/res).
//
// Order matters: rc.exe numbers the RT_CURSOR and RT_ICON images with one counter in the
// order of this script, and the original's numbers (cursors 1-2, icons 3-4, cursors 5-20)
// come out only in this order. It is also the order of the data in Tibia.exe.
//
// The second half is MFC's afxres.rc as Tibia.exe has it (MFC 7.1, English, with the
// splitter, tracker, OLE, property sheet and print preview parts left out). It is written
// out here instead of including the installed MFC's afxres.rc, whose text and set of
// resources differ from MFC 7.1's.

#include "resource.h"
#include <winres.h>

/////////////////////////////////////////////////////////////////////////////
// German (Germany): the client's cursors

LANGUAGE LANG_GERMAN, SUBLANG_GERMAN

IDC_CROSSHAIR           CURSOR                  "cursor_132.cur"
IDC_MAGNIFIER           CURSOR                  "cursor_137.cur"

/////////////////////////////////////////////////////////////////////////////
// English (United States): the client's icon and version information

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

IDR_MAINFRAME           ICON                    "icon_128.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 7,7,2,0
 PRODUCTVERSION 7,7,2,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x4L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		BLOCK "000004b0"
		BEGIN
			VALUE "Comments", "Tibia is a massively multiplayer online roleplaying game. Enter a medieval fantasy scenery, meet players from all over the world and have adventures together with them."
			VALUE "CompanyName", "CipSoft GmbH"
			VALUE "FileDescription", "Tibia Player"
			VALUE "FileVersion", "7.72"
			VALUE "InternalName", "Player"
			VALUE "LegalCopyright", "Copyright (C) CipSoft GmbH 2001-2006"
			VALUE "LegalTrademarks", "Tibia is a registered Trademark of CipSoft GmbH."
			VALUE "OriginalFilename", "Tibia.exe"
			VALUE "ProductName", "Tibia Player"
			VALUE "ProductVersion", "7.72"
		END
	END
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x0, 1200
	END
END

/////////////////////////////////////////////////////////////////////////////
// MFC 7.1's afxres.rc, English (United States)

// AFX_IDC_CONTEXTHELP (context-sensitive help: arrow with a question mark, 32x32 and 16x16)
30977                   CURSOR                  "cursor_30977.cur"

// The mouse wheel cursors of CScrollView, in afxres.rc's order (it is not the order of the IDs)
30999                   CURSOR                  "cursor_30999.cur"     // AFX_IDC_MOUSE_PAN_N
31005                   CURSOR                  "cursor_31005.cur"     // AFX_IDC_MOUSE_PAN_S
31003                   CURSOR                  "cursor_31003.cur"     // AFX_IDC_MOUSE_PAN_E
31001                   CURSOR                  "cursor_31001.cur"     // AFX_IDC_MOUSE_PAN_W
31000                   CURSOR                  "cursor_31000.cur"     // AFX_IDC_MOUSE_PAN_NE
30998                   CURSOR                  "cursor_30998.cur"     // AFX_IDC_MOUSE_PAN_NW
31006                   CURSOR                  "cursor_31006.cur"     // AFX_IDC_MOUSE_PAN_SE
31004                   CURSOR                  "cursor_31004.cur"     // AFX_IDC_MOUSE_PAN_SW
31007                   CURSOR                  "cursor_31007.cur"     // AFX_IDC_MOUSE_PAN_HORZ
31008                   CURSOR                  "cursor_31008.cur"     // AFX_IDC_MOUSE_PAN_VERT
31002                   CURSOR                  "cursor_31002.cur"     // AFX_IDC_MOUSE_PAN_HV
31009                   CURSOR                  "cursor_31009.cur"     // AFX_IDC_MOUSE_ORG_HORZ
31010                   CURSOR                  "cursor_31010.cur"     // AFX_IDC_MOUSE_ORG_VERT
31011                   CURSOR                  "cursor_31011.cur"     // AFX_IDC_MOUSE_ORG_HV

// AFX_IDD_NEWTYPEDLG (CDocManager's "New" dialog); 100 is AFX_IDC_LISTBOX, 0xE146 ID_HELP
30721 DIALOG 9, 26, 183, 70
STYLE DS_MODALFRAME | DS_3DLOOK | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "New"
FONT 8, "MS Shell Dlg"
BEGIN
	LTEXT           "&New ",IDC_STATIC,6,5,123,8,NOT WS_GROUP
	LISTBOX         100,6,15,125,49,WS_VSCROLL | WS_TABSTOP
	DEFPUSHBUTTON   "OK",IDOK,137,6,40,14
	PUSHBUTTON      "Cancel",IDCANCEL,137,23,40,14
	PUSHBUTTON      "&Help",0xE146,137,43,40,14
END

30994                   BITMAP                  "bitmap_30994.bmp"     // AFX_IDB_MINIFRAME_MENU
30996                   BITMAP                  "bitmap_30996.bmp"     // AFX_IDB_CHECKLISTBOX_95

STRINGTABLE
BEGIN
	0xF000                  "Open"                  // AFX_IDS_OPENFILE
	0xF001                  "Save As"               // AFX_IDS_SAVEFILE
	0xF002                  "All Files (*.*)"       // AFX_IDS_ALLFILTER
	0xF003                  "Untitled"              // AFX_IDS_UNTITLED
	0xF006                  "an unnamed file"       // AFX_IDS_UNNAMED_FILE
	0xF011                  "&Hide"                 // AFX_IDS_HIDE
END

STRINGTABLE
BEGIN
	0xF020                  "No error message is available."             // AFX_IDP_NO_ERROR_AVAILABLE
	0xF021                  "An unsupported operation was attempted."    // AFX_IDS_NOT_SUPPORTED_EXCEPTION
	0xF022                  "A required resource was unavailable."       // AFX_IDS_RESOURCE_EXCEPTION
	0xF023                  "Out of memory."                             // AFX_IDS_MEMORY_EXCEPTION
	0xF024                  "An unknown error has occurred."             // AFX_IDS_USER_EXCEPTION
	0xF025                  "An invalid argument was encountered."       // AFX_IDS_INVALID_ARG_EXCEPTION
