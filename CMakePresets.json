{
	"version": 6,
	"cmakeMinimumRequired": {
		"major": 3,
		"minor": 30,
		"patch": 0
	},
	"configurePresets": [
		{
			"name": "base",
			"hidden": true,
			"generator": "Ninja Multi-Config",
			"binaryDir": "${sourceDir}/build/${presetName}",
			"cacheVariables": {
				"CMAKE_CONFIGURATION_TYPES": "Release;Debug",
				"CMAKE_DEFAULT_BUILD_TYPE": "Release"
			}
		},
		{
			"name": "windows-base",
			"hidden": true,
			"inherits": "base",
			"condition": {
				"type": "equals",
				"lhs": "${hostSystemName}",
				"rhs": "Windows"
			},
			"cacheVariables": {
				"CMAKE_C_COMPILER": "cl",
				"CMAKE_CXX_COMPILER": "cl"
			}
		},
		{
			"name": "oracle-x86",
			"displayName": "oracle-x86: today's 32-bit Patella.exe and the difftest (MSVC x86, static MFC; until M6)",
			"description": "Needs MSVC for x86 set up (vcvarsall.bat x86): python -I tools/build.py oracle-x86 does it. Needs Tibia.exe in the root (or PATELLA_TIBIA_EXE) and Python.",
			"inherits": "windows-base",
			"architecture": {
				"value": "x86",
				"strategy": "external"
			},
			"toolset": {
				"value": "host=x86",
				"strategy": "external"
			},
			"cacheVariables": {
				"PATELLA_ORACLE": "ON"
			}
		},
		{
			"name": "windows-x64",
			"displayName": "windows-x64: the Windows product (MSVC x64, static x64 MFC): the client and the unit tests",
			"description": "Needs MSVC for x64 set up (vcvarsall.bat x64): python -I tools/build.py windows-x64 does it. Needs Tibia.exe in the root (or PATELLA_TIBIA_EXE) for the client's resources, and Python; PATELLA_CLIENT=OFF builds only the unit tests.",
			"inherits": "windows-base",
			"architecture": {
				"value": "x64",
				"strategy": "external"
			},
			"toolset": {
				"value": "host=x64",
				"strategy": "external"
			},
			"cacheVariables": {
				"CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
			}
		},
		{
			"name": "windows-x64-gcc",
			"displayName": "windows-x64-gcc: mingw-w64 GCC 16, C++26 on Windows (plan D6); so far the unit tests (issue #9)",
			"description": "Needs mingw-w64 GCC 16 (gcc, g++) on PATH.",
			"inherits": "base",
			"condition": {
				"type": "equals",
				"lhs": "${hostSystemName}",
				"rhs": "Windows"
			},
			"cacheVariables": {
				"CMAKE_C_COMPILER": "gcc",
				"CMAKE_CXX_COMPILER": "g++",
				"CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
			}
		}
	],
	"buildPresets": [
		{
			"name": "oracle-x86",
			"configurePreset": "oracle-x86",
			"configuration": "Release"
		},
		{
			"name": "oracle-x86-debug",
			"configurePreset": "oracle-x86",
			"configuration": "Debug"
		},
		{
			"name": "windows-x64",
			"configurePreset": "windows-x64",
			"configuration": "Release"
		},
		{
			"name": "windows-x64-debug",
			"configurePreset": "windows-x64",
			"configuration": "Debug"
		},
		{
			"name": "windows-x64-gcc",
			"configurePreset": "windows-x64-gcc",
			"configuration": "Release"
		},
		{
			"name": "windows-x64-gcc-debug",
			"configurePreset": "windows-x64-gcc",
			"configuration": "Debug"
		}
	],
	"testPresets": [
		{
			"name": "oracle-x86",
			"configurePreset": "oracle-x86",
			"configuration": "Release",
			"output": {
				"verbosity": "verbose",
				"outputOnFailure": true
			},
			"execution": {
				"noTestsAction": "error"
			}
		},
		{
			"name": "windows-x64",
			"configurePreset": "windows-x64",
			"configuration": "Release",
			"output": {
				"verbosity": "verbose",
				"outputOnFailure": true
			},
			"execution": {
				"noTestsAction": "error"
			}
		},
		{
			"name": "windows-x64-debug",
			"configurePreset": "windows-x64",
			"configuration": "Debug",
			"output": {
				"verbosity": "verbose",
				"outputOnFailure": true
			},
			"execution": {
				"noTestsAction": "error"
			}
		},
		{
			"name": "windows-x64-gcc",
			"configurePreset": "windows-x64-gcc",
			"configuration": "Release",
			"output": {
				"verbosity": "verbose",
				"outputOnFailure": true
			},
			"execution": {
				"noTestsAction": "error"
			}
		},
		{
			"name": "windows-x64-gcc-debug",
			"configurePreset": "windows-x64-gcc",
			"configuration": "Debug",
			"output": {
				"verbosity": "verbose",
				"outputOnFailure": true
			},
			"execution": {
				"noTestsAction": "error"
			}
		}
	],
	"workflowPresets": [
		{
			"name": "oracle-x86",
			"displayName": "oracle-x86: configure, build Release, run the difftest",
			"steps": [
				{
					"type": "configure",
					"name": "oracle-x86"
				},
				{
					"type": "build",
					"name": "oracle-x86"
				},
				{
					"type": "test",
					"name": "oracle-x86"
				}
			]
		},
		{
			"name": "windows-x64",
			"displayName": "windows-x64: configure, build Release, run the unit tests",
			"steps": [
				{
					"type": "configure",
					"name": "windows-x64"
				},
				{
					"type": "build",
					"name": "windows-x64"
				},
				{
					"type": "test",
					"name": "windows-x64"
				}
			]
		},
		{
			"name": "windows-x64-debug",
			"displayName": "windows-x64-debug: configure, build Debug, run the unit tests",
			"steps": [
				{
					"type": "configure",
					"name": "windows-x64"
				},
				{
					"type": "build",
					"name": "windows-x64-debug"
				},
				{
					"type": "test",
					"name": "windows-x64-debug"
				}
			]
		},
		{
			"name": "windows-x64-gcc",
			"displayName": "windows-x64-gcc: configure, build Release, run the unit tests",
			"steps": [
				{
					"type": "configure",
					"name": "windows-x64-gcc"
				},
				{
					"type": "build",
					"name": "windows-x64-gcc"
				},
				{
					"type": "test",
					"name": "windows-x64-gcc"
				}
			]
		},
		{
			"name": "windows-x64-gcc-debug",
			"displayName": "windows-x64-gcc-debug: configure, build Debug, run the unit tests",
			"steps": [
				{
					"type": "configure",
					"name": "windows-x64-gcc"
				},
				{
					"type": "build",
					"name": "windows-x64-gcc-debug"
				},
				{
					"type": "test",
					"name": "windows-x64-gcc-debug"
				}
			]
		}
	]
}
