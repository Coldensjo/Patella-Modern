{
	"version": 6,
	"cmakeMinimumRequired": {
		"major": 3,
		"minor": 30,
		"patch": 0
	},
	"configurePresets": [
		{
			"name": "base",
			"hidden": true,
			"generator": "Ninja Multi-Config",
			"binaryDir": "${sourceDir}/build/${presetName}",
			"cacheVariables": {
				"CMAKE_CONFIGURATION_TYPES": "Release;Debug",
				"CMAKE_DEFAULT_BUILD_TYPE": "Release"
			}
		},
		{
			"name": "windows-base",
			"hidden": true,
			"inherits": "base",
			"condition": {
				"type": "equals",
				"lhs": "${hostSystemName}",
				"rhs": "Windows"
			},
			"cacheVariables": {
				"CMAKE_C_COMPILER": "cl",
				"CMAKE_CXX_COMPILER": "cl"
			}
		},
		{
			"name": "oracle-x86",
			"displayName": "oracle-x86: today's 32-bit Patella.exe and the difftest (MSVC x86, static MFC; until M6)",
			"description": "Needs MSVC for x86 set up (vcvarsall.bat x86): python -I tools/build.py oracle-x86 does it. Needs Tibia.exe in the root (or PATELLA_TIBIA_EXE) and Python.",
			"inherits": "windows-base",
			"architecture": {
				"value": "x86",
				"strategy": "external"
			},
			"toolset": {
				"value": "host=x86",
				"strategy": "external"
			},
			"cacheVariables": {
				"PATELLA_ORACLE": "ON"
			}
		},
		{
			"name": "windows-x64",
			"displayName": "windows-x64: the Windows product (MSVC x64, static x64 MFC): the client and the unit tests",
			"description": "Needs MSVC for x64 set up (vcvarsall.bat x64): python -I tools/build.py windows-x64 does it. Needs Tibia.exe in the root (or PATELLA_TIBIA_EXE) for the client's resources, and Python; PATELLA_CLIENT=OFF builds only the unit tests.",
			"inherits": "windows-base",
			"architecture": {
				"value": "x64",
				"strategy": "external"
			},
			"toolset": {
				"value": "host=x64",
				"strategy": "external"
			},
			"cacheVariables": {
				"CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
			}
		},
		{
			"name": "windows-x64-asan",
			"displayName": "windows-x64-asan: windows-x64 with MSVC's AddressSanitizer (/fsanitize=address): the client, the test build, golden_runner and the unit tests (issue #70)",
			"description": "As windows-x64 (python -I tools/build.py windows-x64-asan sets up MSVC x64; Tibia.exe for the client's resources, PATELLA_CLIENT=OFF for only the unit tests and golden_runner). Debug without /RTC1 and every link without /INCREMENTAL, which ASan does not allow. Needs Visual Studio's C++ AddressSanitizer component.",
			"inherits": "windows-x64",
			"cacheVariables": {
				"PATELLA_SANITIZE": "address",
				"CMAKE_MSVC_DEBUG_INFORMATION_FORMAT": "ProgramDatabase",
				"CMAKE_C_FLAGS_DEBUG": "/Ob0 /Od",
				"CMAKE_CXX_FLAGS_DEBUG": "/Ob0 /Od",
				"CMAKE_EXE_LINKER_FLAGS_DEBUG": "/debug /INCREMENTAL:NO",
				"CMAKE_SHARED_LINKER_FLAGS_DEBUG": "/debug /INCREMENTAL:NO",
				"CMAKE_MODULE_LINKER_FLAGS_DEBUG": "/debug /INCREMENTAL:NO"
			}
		},
		{
			"name": "windows-x64-gcc",
			"displayName": "windows-x64-gcc: mingw-w64 GCC 16, C++26 on Windows (plan D6); so far the unit tests (issue #9)",
			"description": "Needs mingw-w64 GCC 16 (gcc, g++) on PATH.",
			"inherits": "base",
			"condition": {
				"type": "equals",
				"lhs": "${hostSystemName}",
				"rhs": "Windows"
			},
			"cacheVariables": {
				"CMAKE_C_COMPILER": "gcc",
				"CMAKE_CXX_COMPILER": "g++",
				"CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
			}
		},
		{
			"name": "linux-base",
			"hidden": true,
			"inherits": "base",
			"condition": {
				"type": "equals",
				"lhs": "${hostSystemName}",
				"rhs": "Linux"
			},
			"cacheVariables": {
				"PATELLA_CLIENT": "OFF",
				"CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
			}
		},
		{
			"name": "linux-x64-gcc",
			"displayName": "linux-x64-gcc: GCC 16 on Linux x64: patella_core and the unit tests (issue #7)",
			"description": "Needs GCC 16 (gcc, g++) on PATH; the Docker image of docker/linux-x64 has it. On Windows: python -I tools/build.py linux-x64-gcc runs it in that image.",
			"inherits": "linux-base",
			"cacheVariables": {
				"CMAKE_C_COMPILER": "gcc",
				"CMAKE_CXX_COMPILER": "g++"
			}
		},
		{
			"name": "linux-x64-clang",
			"displayName": "linux-x64-clang: Clang on Linux x64 with AddressSanitizer and UBSan: patella_core and the unit tests (issue #7)",
			"description": "Needs Clang (clang, clang++) with compiler-rt on PATH; the Docker image of docker/linux-x64 has Clang 22. On Windows: python -I tools/build.py linux-x64-clang runs it in that image.",
			"inherits": "linux-base",
			"cacheVariables": {
				"CMAKE_C_COMPILER": "clang",
				"CMAKE_CXX_COMPILER": "clang++",
				"PATELLA_SANITIZE": "address,undefined"
			}
		}
	],
	"buildPresets": [
		{
			"name": "oracle-x86",
			"configurePreset": "oracle-x86",
			"configuration": "Release"
		},
		{
