# The clang-tidy configuration of src/ (issue #8; notes/modernization-plan.md, sections 4.1, 4.2 and
# 8). Run it through tools/tidy.py (the findings baseline, --zero, --headers). Until issue #76
# (November 5, 2026) no fix could touch the arguments of TASSERT*, TERROR* or TEND*, which are
# stringized into the exception messages the oracle's tests compared, and tools/tidy.py kept them apart; the
# error paths are compared by outcome since, and the rule is retired (notes/modernization-plan.md, 4.2).
#
# The checks follow the coding standard of plan section 8: owning raw pointers and new/delete
# (cppcoreguidelines-owning-memory, -no-malloc), C string and formatting functions
# (bugprone-unsafe-functions, cppcoreguidelines-pro-type-vararg, modernize-use-std-print), nullptr,
# override, enum class and [[nodiscard]], using instead of typedef (issue #35), = default / = delete for the
# special members (issue #34), the <c...> forms of the C headers and each file including what it uses
# (issue #40), const locals and const member functions (issue #39), named casts instead of C-style casts
# (issue #41), no goto but the original's shared exit paths (issue #42: a NOLINT names the binary's block),
# anonymous namespaces instead of file-scope static (issue #44: the statics kept for the images' .bss carry a
# NOLINT; the check leaves headers alone), pointer parameters to const when only their pointees are read
# (issue #50: clang-tidy's check looks at pointers to integers and floating types), and the bug-prone patterns. The checks that are noise for a
# reconstruction (its parameter lists and integer types are the original's) are off. Issue #143 (clang-tidy 23):
# bugprone-signed-bitwise and bugprone-std-exception-baseclass, which version 23 moved here from hicpp-*, a group this
# file never enabled, are off too (the original's flag arithmetic; TMyException is deliberately no std::exception), and
# misc-const-correctness.AnalyzeParameters, new in 23, is off (parameters are readability-non-const-parameter's, and
# the original's signatures); notes/decisions.md, "#143".
Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-narrowing-conversions,
  -bugprone-implicit-widening-of-multiplication-result,
  -bugprone-reserved-identifier,
  -bugprone-signed-bitwise,
  -bugprone-std-exception-baseclass,
  cppcoreguidelines-avoid-goto,
  cppcoreguidelines-no-malloc,
  cppcoreguidelines-owning-memory,
  cppcoreguidelines-pro-type-cstyle-cast,
  cppcoreguidelines-pro-type-vararg,
  cppcoreguidelines-use-enum-class,
  misc-const-correctness,
  misc-include-cleaner,
  misc-use-anonymous-namespace,
  modernize-deprecated-headers,
  modernize-use-equals-default,
  modernize-use-equals-delete,
  modernize-use-nodiscard,
  modernize-use-nullptr,
  modernize-use-override,
  modernize-use-std-print,
  modernize-use-using,
  readability-make-member-function-const,
  readability-non-const-parameter
WarningsAsErrors: ''
# The headers of src/, not those of src/Extern (third-party code in its own style).
HeaderFilterRegex: '.*[/\\]src[/\\].*'
ExcludeHeaderFilterRegex: '.*[/\\]Extern[/\\].*'
FormatStyle: file
CheckOptions:
  bugprone-unsafe-functions.ReportMoreUnsafeFunctions: true
  # The C headers that the headers of src/ include (common.h, ContentWindows.h, Talk.h) too, not only the
  # main files' (issue #40).
  modernize-deprecated-headers.CheckHeaderFile: true
  # Each file includes what it uses (issue #40), but not the platform's internal headers: a Windows SDK
  # symbol is declared in winuser.h, minwindef.h, corecrt_io.h and the like, which the SDK means to be
  # reached through windows.h and io.h (common.h). The Windows SDK and the UCRT (Windows
  # Kits) are neither suggested nor
  # reported unused; the C and C++ standard library is checked by name (<cstring>, <ostream>), not by path.
  # (POSIX bracket expressions: [/\] is a slash or a backslash.)
  misc-include-cleaner.IgnoreHeaders: '.*[/\]Windows Kits[/\].*'
  # const locals (issue #39): the check's defaults, i.e. values, references and the pointees of pointers
  # (AnalyzeValues, AnalyzeReferences, AnalyzePointers, WarnPointersAsPointers), not the pointers themselves
  # (WarnPointersAsValues off: `T *const p` adds noise and no safety). Spelled out, so that a change of
  # clang-tidy's defaults does not change what CI asks for. The check sees local variables only, not
  # parameters or members. A local that stays non-const for the image carries a NOLINT with its reason
  # (Talk.cpp's TTalkBuffer::Remove; notes/decisions.md, issue #39).
  misc-const-correctness.AnalyzeValues: true
  misc-const-correctness.AnalyzeReferences: true
  misc-const-correctness.AnalyzePointers: true
  misc-const-correctness.WarnPointersAsPointers: true
  misc-const-correctness.WarnPointersAsValues: false
  misc-const-correctness.AnalyzeParameters: false
